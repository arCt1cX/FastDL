{
  "manifest_version": 3,
  "name": "FastDL",
  "version": "1.3.1",
  "description": "Download multi-connessione automatici. Nessuna finestra, nessun programma in background.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "cookies", "notifications", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FastDL",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
